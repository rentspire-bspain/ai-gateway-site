{
  "name": "BoundView",
  "short_name": "BoundView",
  "description": "BoundView \u2014 see the whole picture.",
  "id": "/",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "background_color": "#FCFCF9",
  "theme_color": "#0C0E14",
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "favicon.webp",
      "sizes": "32x32",
      "type": "image/webp"
    }
  ],
  "shortcuts": [
    {
      "name": "New thread",
      "url": "/?source=pwa-shortcut",
      "description": "Start a new conversation"
    },
    {
      "name": "Search threads",
      "url": "/#search",
      "description": "Search your history"
    },
    {
      "name": "Settings",
      "url": "/#settings",
      "description": "Open settings"
    }
  ],
  "share_target": {
    "action": "/",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
    "params": {
      "text": "q"
    }
  }
}