{
  "name": "ai.spaincos",
  "short_name": "ai.spaincos",
  "description": "Where knowledge begins — answers with sources.",
  "id": "/",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "background_color": "#FCFCF9",
  "theme_color": "#14646B",
  "icons": [
    {
      "src": "icons/icon-192.webp",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-512.webp",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-maskable-512.webp",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "favicon.webp",
      "sizes": "32x32",
      "type": "image/webp"
    }
  ],
  "shortcuts": [
    {
      "name": "New thread",
      "short_name": "New",
      "url": "/?source=pwa-shortcut&intent=new",
      "description": "Start a new conversation",
      "icons": [
        {
          "src": "/icons/icon-192.webp",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Search threads",
      "short_name": "Search",
      "url": "/?source=pwa-shortcut&intent=search",
      "description": "Search your history",
      "icons": [
        {
          "src": "/icons/icon-192.webp",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Settings",
      "short_name": "Settings",
      "url": "/?source=pwa-shortcut&intent=settings",
      "description": "Open settings",
      "icons": [
        {
          "src": "/icons/icon-192.webp",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],
  "share_target": {
    "action": "/",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
    "params": {
      "title": "title",
      "text": "q",
      "url": "url"
    }
  },
  "lang": "en",
  "dir": "ltr",
  "orientation": "any",
  "categories": [
    "productivity",
    "utilities",
    "education"
  ],
  "display_override": [
    "window-controls-overlay",
    "standalone",
    "minimal-ui"
  ],
  "launch_handler": {
    "client_mode": [
      "focus-existing",
      "auto"
    ]
  },
  "handle_links": "preferred",
  "protocol_handlers": [
    {
      "protocol": "web+aispaincos",
      "url": "/?q=%s"
    }
  ],
  "file_handlers": [
    {
      "action": "/?source=file",
      "accept": {
        "text/plain": [
          ".txt",
          ".md"
        ],
        "text/csv": [
          ".csv"
        ],
        "application/json": [
          ".json"
        ]
      }
    }
  ],
  "screenshots": [
    {
      "src": "/icons/shot-narrow.png",
      "sizes": "1280x720",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "ai.spaincos.com answers with citations"
    },
    {
      "src": "/icons/shot-wide.png",
      "sizes": "2560x1440",
      "type": "image/png",
      "form_factor": "wide",
      "label": "The full research workspace"
    }
  ]
}