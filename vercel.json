{
  "crons": [
    {
      "path": "/api/retention?execute=1",
      "schedule": "0 9 * * *"
    }
  ],
  "functions": {
    "api/bv-render.js": {
      "includeFiles": "{terms,privacy,docs,help,status,verify,offline,pricing,refund,features,compare,changelog,index,auth-interstitial}.{html,boundview.html,es.html}"
    }
  },
  "routes": [
    {
      "src": "/admin",
      "dest": "/admin.html"
    },
    {
      "src": "/(vendor|fonts)/(.*)",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      },
      "continue": true
    },
    {
      "src": "/(qa|qa-private|browser-service|voice-service|supabase|sql|tests|tools)/.*",
      "status": 404
    },
    {
      "src": "/(.*)",
      "headers": {
        "X-Content-Type-Options": "nosniff",
        "X-Frame-Options": "DENY",
        "Referrer-Policy": "strict-origin-when-cross-origin",
        "Permissions-Policy": "camera=(), microphone=(self), geolocation=()",
        "Content-Security-Policy": "frame-ancestors 'none'; object-src 'none'; base-uri 'none'",
        "X-Permitted-Cross-Domain-Policies": "none",
        "Cross-Origin-Opener-Policy": "same-origin",
        "Cross-Origin-Resource-Policy": "same-origin"
      },
      "continue": true
    },
    {
      "src": "/",
      "dest": "/api/bv-render"
    },
    {
      "src": "/index.html",
      "dest": "/api/bv-render"
    },
    {
      "src": "/t/(.*)",
      "dest": "/api/bv-render"
    },
    {
      "src": "/verify",
      "dest": "/verify.html",
      "status": 307
    },
    {
      "src": "/docs/api",
      "dest": "/api/bv-render?page=docs-api"
    },
    {
      "src": "/docs",
      "dest": "/api/bv-render?page=docs"
    },
    {
      "src": "/docs/$",
      "dest": "/api/bv-render?page=docs"
    },
    {
      "src": "/pricing/?",
      "dest": "/api/bv-render?page=pricing"
    },
    {
      "src": "/refund/?",
      "dest": "/api/bv-render?page=refund"
    },
    {
      "src": "/features/?",
      "dest": "/api/bv-render?page=features"
    },
    {
      "src": "/compare/?",
      "dest": "/api/bv-render?page=compare"
    },
    {
      "src": "/changelog/?",
      "dest": "/api/bv-render?page=changelog"
    },
    {
      "src": "/help",
      "dest": "/api/bv-render?page=help"
    },
    {
      "src": "/help/$",
      "dest": "/api/bv-render?page=help"
    },
    {
      "src": "/terms",
      "dest": "/api/bv-render?page=terms"
    },
    {
      "src": "/terms/$",
      "dest": "/api/bv-render?page=terms"
    },
    {
      "src": "/verify/$",
      "dest": "/verify.html",
      "status": 307
    },
    {
      "src": "/privacy",
      "dest": "/api/bv-render?page=privacy"
    },
    {
      "src": "/privacy/$",
      "dest": "/api/bv-render?page=privacy"
    },
    {
      "src": "/status",
      "dest": "/api/bv-render?page=status"
    },
    {
      "src": "/status/$",
      "dest": "/api/bv-render?page=status"
    },
    {
      "src": "/es/help/?",
      "dest": "/api/bv-render?page=es-help"
    },
    {
      "src": "/es/docs/?",
      "dest": "/api/bv-render?page=es-docs"
    },
    {
      "src": "/es/status/?",
      "dest": "/api/bv-render?page=es-status"
    },
    {
      "src": "/es/terms/?",
      "dest": "/api/bv-render?page=es-terms"
    },
    {
      "src": "/es/privacy/?",
      "dest": "/api/bv-render?page=es-privacy"
    },
    {
      "src": "/es/verify/?",
      "dest": "/api/bv-render?page=es-verify"
    },
    {
      "src": "/es/offline/?",
      "dest": "/api/bv-render?page=es-offline"
    },
    {
      "handle": "filesystem"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(self), geolocation=()"
        }
      ]
    }
  ]
}