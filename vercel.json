{
  "crons": [
    {
      "path": "/api/retention?execute=1",
      "schedule": "0 9 * * *"
    }
  ],
  "functions": {
    "api/bv-render.js": {
      "includeFiles": "{terms,privacy,docs,help,status,index}.{html,boundview.html}"
    }
  },
  "routes": [
    {
      "src": "/(qa|qa-private|browser-service|voice-service|supabase|sql|tests|tools)/.*",
      "status": 404
    },
    {
      "src": "/(.*)",
      "headers": {
        "X-Content-Type-Options": "nosniff",
        "X-Frame-Options": "DENY",
        "Referrer-Policy": "strict-origin-when-cross-origin",
        "Permissions-Policy": "camera=(), microphone=(self), geolocation=()",
        "Content-Security-Policy": "frame-ancestors 'none'; object-src 'none'; base-uri 'none'",
        "X-Permitted-Cross-Domain-Policies": "none"
      },
      "continue": true
    },
    {
      "src": "/",
      "dest": "/api/bv-render"
    },
    {
      "src": "/index.html",
      "dest": "/api/bv-render"
    },
    {
      "src": "/t/(.*)",
      "dest": "/api/bv-render"
    },
    {
      "src": "/verify",
      "dest": "/verify.html",
      "status": 307
    },
    {
      "src": "/docs",
      "dest": "/api/bv-render?page=docs"
    },
    {
      "src": "/docs/$",
      "dest": "/api/bv-render?page=docs"
    },
    {
      "src": "/help",
      "dest": "/api/bv-render?page=help"
    },
    {
      "src": "/help/$",
      "dest": "/api/bv-render?page=help"
    },
    {
      "src": "/terms",
      "dest": "/api/bv-render?page=terms"
    },
    {
      "src": "/terms/$",
      "dest": "/api/bv-render?page=terms"
    },
    {
      "src": "/verify/$",
      "dest": "/verify.html",
      "status": 307
    },
    {
      "src": "/privacy",
      "dest": "/api/bv-render?page=privacy"
    },
    {
      "src": "/privacy/$",
      "dest": "/api/bv-render?page=privacy"
    },
    {
      "src": "/status",
      "dest": "/api/bv-render?page=status"
    },
    {
      "src": "/status/$",
      "dest": "/api/bv-render?page=status"
    },
    {
      "src": "/es/help/?",
      "dest": "/help.es.html"
    },
    {
      "src": "/es/docs/?",
      "dest": "/docs.es.html"
    },
    {
      "src": "/es/status/?",
      "dest": "/status.es.html"
    },
    {
      "src": "/es/terms/?",
      "dest": "/terms.es.html"
    },
    {
      "src": "/es/privacy/?",
      "dest": "/privacy.es.html"
    },
    {
      "src": "/es/verify/?",
      "dest": "/verify.es.html"
    },
    {
      "src": "/es/offline/?",
      "dest": "/offline.es.html"
    },
    {
      "handle": "filesystem"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(self), geolocation=()"
        }
      ]
    }
  ]
}